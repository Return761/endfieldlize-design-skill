{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvaluationReport",
  "type": "object",
  "properties": {
    "kind": {
      "const": "EvaluationReport"
    },
    "version": {
      "const": 1
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "runAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "kind": {
            "enum": [
              "automated",
              "reviewer",
              "unverified"
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "observed",
              "pending"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2400
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "minItems": 0,
            "maxItems": 200
          },
          "viewport": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "claim",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 500
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?:[\\w.-]+/)*[\\w.-]+$"
      },
      "minItems": 0,
      "maxItems": 200
    }
  },
  "required": [
    "kind",
    "version",
    "target",
    "runAt",
    "environment",
    "entries",
    "artifacts"
  ],
  "additionalProperties": false
}
