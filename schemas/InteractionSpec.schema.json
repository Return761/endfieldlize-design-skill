{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InteractionSpec",
  "type": "object",
  "properties": {
    "kind": {
      "const": "InteractionSpec"
    },
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "task": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "completion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "id",
          "task",
          "completion"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "id",
          "label",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "multiplicity": {
            "enum": [
              "1:1",
              "1:N",
              "N:1",
              "N:N"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "label",
          "multiplicity"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    },
    "initialState": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "effect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "from",
          "to",
          "action",
          "effect"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "navigation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "hardCase": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2400
          },
          "tradeoff": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          }
        },
        "required": [
          "id",
          "name",
          "model",
          "navigation",
          "hardCase",
          "tradeoff"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    },
    "chosen": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
    }
  },
  "required": [
    "kind",
    "version",
    "title",
    "jobs",
    "entities",
    "relations",
    "states",
    "initialState",
    "transitions",
    "alternatives",
    "chosen"
  ],
  "additionalProperties": false
}
